{
  "name": "mathathlon",
  "version": "1.0.0",
  "description": "Real-time competitive math platform for K-8 classrooms",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite client",
    "build": "vite build client",
    "start": "NODE_ENV=production node server/index.js",
    "db:init": "node server/db/init.js",
    "db:seed": "node server/db/seed.js",
    "test": "node --test server/**/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.6.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "nanoid": "^5.0.7",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "concurrently": "^9.0.1",
    "preact": "^10.24.0",
    "vite": "^5.4.0"
  }
}
